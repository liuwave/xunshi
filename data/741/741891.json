    "title": "习家池大堤",
    "title_tr": "習家池大堤",
    "author": "颜荛",
    "author_tr": "顏蕘",
    "dynasty": "唐",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "习郁穿池事胜游，山翁酣饮继风流。",
    "content_tr": "習郁穿池事勝游，山翁酣飲繼風流。"
