    "title": "接待",
    "title_tr": "接待",
    "author": "释慧开",
    "author_tr": "釋慧開",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "洋铜汁羹，热铁丸饭。\n滴粒才沾，通身腐烂。",
    "content_tr": "洋銅汁羹，熱鐵丸飯。\n滴粒纔沾，通身腐爛。"
