    "title": "与观非和尚",
    "title_tr": "與觀非和尚",
    "author": "黄锦",
    "author_tr": "黃錦",
    "dynasty": "明",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "日观其非，何者为是。\n是非两忘，山飞水峙。",
    "content_tr": "日觀其非，何者爲是。\n是非兩忘，山飛水峙。"
  },
