    "title": "拾得磨墨赞",
    "title_tr": "拾得磨墨贊",
    "author": "释绍昙",
    "author_tr": "釋紹曇",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "可怜拾得，侧望徒劳。\n墨有消时恨不消。",
    "content_tr": "可憐拾得，側望徒勞。\n墨有消時恨不消。"
  },
