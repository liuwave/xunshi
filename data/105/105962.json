    "title": "宫词二首 一",
    "title_tr": "宮詞二首 一",
    "author": "张祜",
    "author_tr": "張祜",
    "dynasty": "唐",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "故国三千里，深宫二十年。\n一声河满子，双泪落君前。",
    "content_tr": "故國三千里，深宮二十年。\n一聲河滿子，雙淚落君前。"
  },
