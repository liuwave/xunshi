    "title": "白菜",
    "title_tr": "白菜",
    "author": "成鹫",
    "author_tr": "成鷲",
    "dynasty": "明",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "老根嫩茎，黄花绿叶。\n香积有馀，齑缸总摄。",
    "content_tr": "老根嫩莖，黃花綠葉。\n香積有餘，齏缸總攝。"
  },
