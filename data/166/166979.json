    "title": "紫白茄",
    "title_tr": "紫白茄",
    "author": "成鹫",
    "author_tr": "成鷲",
    "dynasty": "明",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "紫岂夺朱，白可受采。\n并蒂连花，犍椎相会。",
    "content_tr": "紫豈奪朱，白可受採。\n並蒂連花，犍椎相會。"
  },
