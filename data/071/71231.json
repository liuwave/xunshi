    "title": "自取池",
    "title_tr": "自取池",
    "author": "戚继光",
    "author_tr": "戚繼光",
    "dynasty": "明",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "挠之亦浊，澄之亦清。\n名曰自取，濯足濯缨。",
    "content_tr": "撓之亦濁，澄之亦清。\n名曰自取，濯足濯纓。"
  },
