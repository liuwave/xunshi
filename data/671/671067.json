    "title": "临济和尚赞",
    "title_tr": "臨濟和尚贊",
    "author": "释师观",
    "author_tr": "釋師觀",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "一喝当阳，寸丝不挂。\n挠括丛林，至今话欛。",
    "content_tr": "一喝當陽，寸絲不挂。\n撓括叢林，至今話欛。"
