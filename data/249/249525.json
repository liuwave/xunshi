    "title": "题玉簪",
    "title_tr": "題玉簮",
    "author": "杨士奇",
    "author_tr": "楊士奇",
    "dynasty": "明",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "姑射之姝，翠旌如帏。\n惟显簪玉，不睹容辉。",
    "content_tr": "姑射之姝，翠旍如幃。\n惟顯簮玉，不覩容輝。"
  },
