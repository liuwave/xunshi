    "title": "四者吟",
    "title_tr": "四者吟",
    "author": "邵雍",
    "author_tr": "邵雍",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "财色名势，为世所亲。\n四者不动，然后见人。",
    "content_tr": "財色名勢，爲世所親。\n四者不動，然後見人。"
