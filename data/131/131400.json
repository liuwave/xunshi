    "title": "张士信杨完者谣",
    "title_tr": "張士信楊完者謠",
    "author": "无名氏",
    "author_tr": "無名氏",
    "dynasty": "元",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "死不怨，泰州张；\n生不谢，宝庆杨。",
    "content_tr": "死不怨，泰州張；\n生不謝，寶慶楊。"
