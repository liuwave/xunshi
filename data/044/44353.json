    "title": "题洛阳县壁",
    "title_tr": "題洛陽縣壁",
    "author": "李兼",
    "author_tr": "李兼",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "猾吏畏服，县妖破胆。\n好录政声，闻于御览。",
    "content_tr": "猾吏畏服，縣妖破膽。\n好錄政聲，聞於御覽。"
  },
