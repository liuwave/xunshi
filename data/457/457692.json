    "title": "示善应道人",
    "title_tr": "示善應道人",
    "author": "释咸杰",
    "author_tr": "釋咸傑",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "善应无私，当阳有准。\n直下承当，入佛祖阃。",
    "content_tr": "善應無私，當陽有準。\n直下承當，入佛祖閫。"
  },
