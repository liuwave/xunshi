    "title": "听弹琴",
    "title_tr": "聽彈琴",
    "author": "刘长卿",
    "author_tr": "劉長卿",
    "dynasty": "唐",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "泠泠七丝上，静听松风寒。\n古调虽自爱，今人多不弹。",
    "content_tr": "泠泠七絲上，靜聽松風寒。\n古調雖自愛，今人多不彈。"
  },
