    "title": "哑子观音赞",
    "title_tr": "啞子觀音贊",
    "author": "释子益",
    "author_tr": "釋子益",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "赞者舌秃，画者口哑。\n篮里锦鳞，愈增高价。",
    "content_tr": "贊者舌禿，畫者口啞。\n籃裏錦鱗，愈增高價。"
  },
