    "title": "劝人 七",
    "title_tr": "勸人 七",
    "author": "义存",
    "author_tr": "義存",
    "dynasty": "唐",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "枯木藏龙，雷动必惊。\n惊者是少，不惊者多。",
    "content_tr": "枯木藏龍，雷動必驚。\n驚者是少，不驚者多。"
