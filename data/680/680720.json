    "title": "猪头和尚赞",
    "title_tr": "豬頭和尚贊",
    "author": "释法薰",
    "author_tr": "釋法薰",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "手把猪头，易见难识。\n莫教说破，分文不直。",
    "content_tr": "手把豬頭，易見難識。\n莫教說破，分文不直。"
