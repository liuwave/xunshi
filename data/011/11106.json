    "title": "修省斋诗",
    "title_tr": "脩省齋詩",
    "author": "吴当",
    "author_tr": "吳當",
    "dynasty": "元",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "惟皇降衷，弗忚弗亏。\n习远情肆，始沦以隳。",
    "content_tr": "惟皇降衷，弗忚弗虧。\n習遠情肆，始淪以隳。"
