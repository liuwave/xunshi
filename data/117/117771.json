    "title": "心迹吟",
    "title_tr": "心跡吟",
    "author": "邵雍",
    "author_tr": "邵雍",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "圣人了心，贤人了迹。\n了心无穷，了迹无极。",
    "content_tr": "聖人了心，賢人了跡。\n了心無窮，了跡無極。"
  },
