    "title": "无腼吟",
    "title_tr": "無靦吟",
    "author": "邵雍",
    "author_tr": "邵雍",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "事曾经见，物曾持炼。\n天地之间，俯仰无腼。",
    "content_tr": "事曾經見，物曾持鍊。\n天地之間，俯仰無靦。"
  },
