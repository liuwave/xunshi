    "title": "当断吟",
    "title_tr": "當斷吟",
    "author": "邵雍",
    "author_tr": "邵雍",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "断以决疑，疑不可缓。\n当断不断，反受其乱。",
    "content_tr": "斷以決疑，疑不可緩。\n當斷不斷，反受其亂。"
  },
