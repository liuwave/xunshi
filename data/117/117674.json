    "title": "小人吟",
    "title_tr": "小人吟",
    "author": "邵雍",
    "author_tr": "邵雍",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "小人无节，弃本逐末。\n喜思其与，怒思其夺。",
    "content_tr": "小人無節，棄本逐末。\n喜思其與，怒思其奪。"
