    "title": "自述真赞",
    "title_tr": "自述真讚",
    "author": "释通慧",
    "author_tr": "釋通慧",
    "dynasty": "宋",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "真兮寥廓，郢人图雘。\n岳耸云空，澄潭月跃。",
    "content_tr": "真兮寥廓，郢人圖雘。\n嶽聳雲空，澄潭月躍。"
