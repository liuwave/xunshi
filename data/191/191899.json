    "title": "罾布谣",
    "title_tr": "罾布謠",
    "author": "屈大均",
    "author_tr": "屈大均",
    "dynasty": "清",
    "kind_cn": "诗",
    "rhythmic": null,
    "content": "以罾为布，渔家所造。\n著以取鱼，不忧风飓。",
    "content_tr": "以罾爲布，漁家所造。\n著以取魚，不憂風颶。"
  },
